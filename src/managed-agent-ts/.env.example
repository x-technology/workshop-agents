# Anthropic API key from platform.claude.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# GitHub personal access token (fine-grained, repo scope)
GITHUB_TOKEN=ghp_your_github_token_here

# GitHub repo to mount (e.g. https://github.com/your-org/your-repo)
GITHUB_REPO_URL=https://github.com/your-org/your-repo

# IDs saved by setup.ts — filled in automatically after first run
AGENT_ID=
ENVIRONMENT_ID=
